# Cross target: 64-bit ARM Linux, FROM A LINUX BUILD MACHINE.
# armv8 is Conan's canonical name for what the compiler calls aarch64.
#
# Change build_folder_vars here and it breaks the matching preset's
# toolchainFile. The toolchain file keeps the GNU triple aarch64-linux-gnu,
# because that is what the compiler binaries are called.

[settings]
os=Linux
arch=armv8
compiler=gcc
compiler.version=13
compiler.cppstd=23
compiler.libcxx=libstdc++11
build_type=Release

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.cmake.cmaketoolchain:user_toolchain=["{{ os.path.join(profile_dir, "..", "cmake", "toolchains", "aarch64-linux-gnu.cmake") }}"]
tools.cmake.cmake_layout:build_folder_vars=["settings.os", "settings.arch", "settings.build_type"]
tools.build:skip_test=True

# Baked into conan_toolchain.cmake as CMAKE_SYSROOT, works using a plain
# cmake --preset with no environment activation.
#
# Set only when ETESCA_AARCH64_SYSROOT is exported. A distro cross toolchain
# (Debian/Ubuntu gcc-aarch64-linux-gnu, which is what CI uses) knows its own
# sysroot and must NOT be given one; a bare Linaro/vendor toolchain must be
# given one.

{% if os.getenv("ETESCA_AARCH64_SYSROOT") %}
tools.build:sysroot={{ os.getenv("ETESCA_AARCH64_SYSROOT") }}
{% endif %}
