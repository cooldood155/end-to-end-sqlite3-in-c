@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/etescaTargets.cmake")

if(NOT TARGET etesca::etesca)
  if(TARGET etesca::shared OR TARGET etesca::static)
    if(BUILD_SHARED_LIBS AND TARGET etesca::shared)
      set(_etesca_variant etesca::shared)
    elseif(NOT BUILD_SHARED_LIBS AND TARGET etesca::static)
      set(_etesca_variant etesca::static)
    elseif(TARGET etesca::shared)
      set(_etesca_variant etesca::shared)
    else()
      set(_etesca_variant etesca::static)
    endif()

    add_library(etesca::etesca INTERFACE IMPORTED)
    target_link_libraries(etesca::etesca INTERFACE ${_etesca_variant})
    unset(_etesca_variant)
  else()
    set(etesca_FOUND FALSE)
    set(etesca_NOT_FOUND_MESSAGE
      "The etesca package in '${CMAKE_CURRENT_LIST_DIR}' exports no library target.")
    return()
  endif()
endif()

foreach(_etesca_component IN LISTS etesca_FIND_COMPONENTS)
  if(TARGET etesca::${_etesca_component})
    set(etesca_${_etesca_component}_FOUND TRUE)
  else()
    set(etesca_${_etesca_component}_FOUND FALSE)
  endif()
endforeach()
unset(_etesca_component)

check_required_components(etesca)
